server {
    listen 8080;
    listen [::]:8080;
    root /home/site/wwwroot/public;

    # Submit Roadblock sends up to 5 files x 10MB in one request; nginx's
    # default 1MB limit returned "413 Request Entity Too Large".
    client_max_body_size 60M;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-XSS-Protection "1; mode=block";

    index index.php index.html index.htm hostingstart.html;

    # Compress text responses (HTML, CSS, JS, JSON, SVG): pages are often
    # 5-10x smaller over the wire.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml;

    # Vite build files have a content hash in their name, so they can be
    # cached forever; a new deploy produces new names.
    location /build/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # Uploaded photos and site images: cache for a week.
    location ~* ^/(storage|images)/.*\.(jpg|jpeg|png|gif|webp|svg|ico)$ {
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }

    location / {
        index index.php index.html index.htm hostingstart.html;
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
    }

    location ~ /\.ht {
        deny all;
    }
}
