APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lync
# DB_USERNAME=root
# DB_PASSWORD=lync

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Verification/reset emails need a real mailer to actually send anything —
# the "log" driver just writes them to storage/logs/laravel.log, which
# looks like it worked (no error) but nothing ever reaches an inbox.
#
# All outgoing mail is sent from Argee's Gmail account (shared on purpose,
# so every environment sends "from" the same address) — leave these as-is,
# nothing to fill in yourself here.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=argeerbueno@gmail.com
MAIL_PASSWORD="tipafuwtzgbwfodb"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=argeerbueno@gmail.com
MAIL_FROM_NAME="PUP TBIDO"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Powers the Assessment Hub's "Generate with AI" button (Venture Exit /
# Document 13 draft content). Get a free key at https://aistudio.google.com
# (Google account, no card required) — the button shows a clean "not
# configured" message when this is left blank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

VITE_APP_NAME="${APP_NAME}"

# Email of the existing admin to make Super Admin on first deploy (migration 000076).
SUPER_ADMIN_EMAIL=
