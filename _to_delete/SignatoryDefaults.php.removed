<?php

namespace App\Support;

/**
 * What a signatory block starts with on a brand-new (never saved) form:
 * its caption ("Prepared By:") and its position/title. Names always start
 * blank - the admin types them in. Every value stays editable, and once a
 * form has been saved its stored values are used as-is (a cleared
 * signatory stays cleared).
 *
 * Used by the Assessment Hub's Pre-/Post-Assessment form, Documents 6/7/8
 * (Active-Assessment) and the Startup Exit Form (Venture Exit).
 */
class SignatoryDefaults
{
    private const DIRECTOR = 'Director, TBIDO';

    private const DIRECTOR_PROJECT_LEADER = "Director, TBIDO\nProject Leader, DOST HEIRIT";

    private const PORTFOLIO_COORDINATOR = 'Portfolio Coordinator, TBIDO';

    private const PORTFOLIO_COORDINATOR_PRE = "Portfolio Coordinator, TBIDO\nProject Technical Assistant II, DOST HEIRIT";

    private const STARTUP_DEVELOPMENT_CHIEF = 'Startup Development Chief, TBIDO';

    private const INCUBATION_MANAGEMENT_CHIEF = 'Incubation Management Chief, TBIDO';

    private const TECHNOLOGY_DEVELOPMENT_CHIEF = 'Technology Development Chief, TBIDO';

    /**
     * readiness_level_assessments columns => default value.
     * Post-Assessment prints a single position line for "Evaluated by".
     *
     * @return array<string, string>
     */
    public static function readiness(bool $isPostAssessment): array
    {
        $evaluatedPosition = $isPostAssessment ? self::PORTFOLIO_COORDINATOR : self::PORTFOLIO_COORDINATOR_PRE;

        $defaults = [
            // TRL: Prepared By / Noted By / Approved by
            'prepared_by_label' => 'Prepared By:',
            'trl_noted_by_label' => 'Noted By:',
            'approved_by_label' => 'Approved by:',
            'approved_by_position' => "Director, Technology Business Incubation and Development Office\nProject Leader, DOST-HEIRIT",
        ];

        // MRL / TMRL / SRL: Evaluated by / Reviewed by / Noted by
        foreach (['mrl', 'tmrl', 'srl'] as $type) {
            $defaults["{$type}_evaluated_by_label"] = 'Evaluated by:';
            $defaults["{$type}_reviewed_by_label"] = 'Reviewed by:';
            $defaults["{$type}_noted_by_label"] = 'Noted by:';
            $defaults["{$type}_evaluated_by_position"] = $evaluatedPosition;
            $defaults["{$type}_reviewed_by_position"] = $type === 'srl' ? self::INCUBATION_MANAGEMENT_CHIEF : self::STARTUP_DEVELOPMENT_CHIEF;
            $defaults["{$type}_noted_by_position"] = self::DIRECTOR_PROJECT_LEADER;
        }

        return $defaults;
    }

    /**
     * Document JSON keys => default value, per document number.
     *
     * @return array<string, mixed>
     */
    public static function document(int $documentNumber): array
    {
        return match ($documentNumber) {
            // Document 6 - Startup Growth Strategy: three Prepared By rows + Noted By
            6 => [
                'prepared_by_label' => 'Prepared By:',
                'prepared_by_positions' => [
                    self::STARTUP_DEVELOPMENT_CHIEF,
                    self::INCUBATION_MANAGEMENT_CHIEF,
                    self::TECHNOLOGY_DEVELOPMENT_CHIEF,
                ],
                'noted_by_label' => 'Noted By:',
                'noted_by_position' => self::DIRECTOR,
            ],
            // Document 7 - Weekly Check-ins
            7 => [
                'prepared_by_label' => 'Prepared By:',
                'prepared_by_position' => self::PORTFOLIO_COORDINATOR,
                'noted_by_label' => 'Noted By:',
                'noted_by_position' => 'Assigned Chief, TBIDO',
            ],
            // Document 8 - Prototype Validation
            8 => [
                'validated_by_label' => 'Validated By:',
                'noted_by_label' => 'Noted By:',
                'noted_by_position' => 'Chief, Technology Development Section, PUP',
                'approved_by_label' => 'Approved By:',
                'approved_by_position' => "Director, Technology Business Incubation and Development Office, PUP\nProject Leader, DOST-HEIRIT",
            ],
            // Document 13 - Startup Exit Form (Venture Exit)
            13 => [
                'evaluated_by_label' => 'Evaluated by:',
                'evaluated_by_position' => self::PORTFOLIO_COORDINATOR,
                'reviewed_by_label' => 'Reviewed by:',
                'reviewed_by_position' => self::INCUBATION_MANAGEMENT_CHIEF,
                'noted_by_label' => 'Noted by:',
                'noted_by_position' => self::DIRECTOR,
            ],
            default => [],
        };
    }
}
